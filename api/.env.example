# Database
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
DATABASE_URL_DIRECT=postgres://user:pass@direct-host/db?sslmode=require

# Internal API key (shared with Next.js)
INTERNAL_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# LLM (Gemini)
GEMINI_API_KEY=
LLM_MODEL=gemini-2.0-flash

# News sources
FINNHUB_API_KEY=
MARKETAUX_API_KEY=

# SEC EDGAR (required: app name + your email)
SEC_USER_AGENT=StockDash emailmu@gmail.com

# Server
PORT=8080
